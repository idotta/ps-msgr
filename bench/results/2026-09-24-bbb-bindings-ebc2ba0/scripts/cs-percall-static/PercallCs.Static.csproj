<Project Sdk="Microsoft.NET.Sdk">
  <!-- cs-percall with libpsmsgr.a linked in (DirectPInvoke). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../cs-percall/Program.cs" />
    <ProjectReference Include="../../../bindings/csharp/PsMsgr/PsMsgr.csproj" />
    <DirectPInvoke Include="libpsmsgr.so.1" />
    <NativeLibrary Include="/src/build/armhf-release/libpsmsgr.a" />
  </ItemGroup>
</Project>
